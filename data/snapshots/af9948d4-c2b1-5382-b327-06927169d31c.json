    "raw": {
      "id": 50499858,
      "headline": "House Overwhelmingly Passes Bipartisan Housing Bill To Tackle Affordability Crisis, Push Localities To Build More Homes",
      "source": "benzinga",
      "url": "https://www.benzinga.com/news/politics/26/02/50499858/house-overwhelmingly-passes-bipartisan-housing-bill-to-tackle-affordability-crisis-push-localities-to-build-more-homes",
      "summary": "Housing package passes House, aims to address affordability crisis by encouraging more home construction and reducing barriers. Senate next.",
      "created_at": "2026-02-10T01:59:13+00:00",
      "updated_at": "2026-02-10T01:59:14+00:00",
