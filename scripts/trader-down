#!/usr/bin/env bash
# Stop trader and/or tick_collector.
#
# Usage:
#   trader-down            Stop both (kills entire session)
#   trader-down trader     Stop trader only (tick_collector keeps running)
#   trader-down tick       Stop tick_collector only (trader keeps running)

set -euo pipefail

SESSION="trader"
WINDOW="services"
TARGET="${1:-all}"

# Clean up orphaned processes that may survive a crash.
# pkill returns 1 if no match — || true prevents set -e from aborting.
cleanup_trader() {
    pkill -f "trader.main" 2>/dev/null || true
    pkill -f "insight_sentry_news" 2>/dev/null || true
    pkill -f "alpaca_news.py" 2>/dev/null || true
}

cleanup_tick() {
    pkill -f "python -m tick_collector" 2>/dev/null || true
}

has_window() {
    local WINDOW_NAME="$1"
    tmux has-session -t "$SESSION" 2>/dev/null && \
        tmux list-windows -t "$SESSION" -F '#{window_name}' | grep -qx "$WINDOW_NAME"
}

pane_id_for_title() {
    local TITLE="$1"
    tmux list-panes -a -F '#{session_name}\t#{pane_title}\t#{pane_id}' 2>/dev/null | \
        awk -F '\t' -v session="$SESSION" -v title="$TITLE" '$1 == session && $2 == title { print $3; exit }'
}

kill_service() {
    local SERVICE="$1"
    local PANE_ID
    PANE_ID="$(pane_id_for_title "$SERVICE")"

    if [[ -n "$PANE_ID" ]]; then
        tmux kill-pane -t "$PANE_ID"
        if has_window "$WINDOW"; then
            tmux select-layout -t "$SESSION:$WINDOW" even-vertical >/dev/null 2>&1 || true
        fi
        echo "Stopped $SERVICE."
    elif has_window "$SERVICE"; then
        tmux kill-window -t "$SESSION:$SERVICE"
        echo "Stopped $SERVICE."
    else
        echo "$SERVICE tmux pane/window not running."
    fi

    # If no windows remain, session is already gone
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "Session '$SESSION' ended (no panes/windows left)."
    fi
}

case "$TARGET" in
    all)
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux kill-session -t "$SESSION"
            echo "Stopped session '$SESSION'."
        else
            echo "No '$SESSION' session running."
        fi
        cleanup_trader
        cleanup_tick
        echo "Cleaned up any orphaned processes."
        ;;
    trader)
        kill_service "trader"
        cleanup_trader
        echo "Cleaned up any orphaned trader/websocket processes."
        ;;
    tick)
        kill_service "tick_collector"
        cleanup_tick
        echo "Cleaned up any orphaned tick_collector processes."
        ;;
    *)
        echo "Usage: trader-down [trader|tick]" >&2
        exit 1
        ;;
esac
