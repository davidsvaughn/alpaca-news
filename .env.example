# copy '.env.example' to '.env' and fill in your Alpaca API key and secret
ALPACA_API_KEY=<your-key-here>
ALPACA_SECRET_KEY=<your-secret-here>

# -----------------------------
# trader/ research assistant
# -----------------------------

# LLM keys (at least one required)
OPENAI_API_KEY=<optional>
GEMINI_API_KEY=<optional>
GOOGLE_API_KEY=<optional>
# Grok / xAI (OpenAI-compatible at https://api.x.ai/v1)
XAI_API_KEY=<optional>
XAI_BASE_URL=https://api.x.ai/v1

# FinnHub (free tier — company news)
FINNHUB_API_KEY=<optional>

# Modes
TRADING_MODE=paper
LEARNING_MODE=true
DEBUG=false

# Development helpers
MOCK_LLM=true
BACKFILL_ON_START=true
BACKFILL_LIMIT=5

# Paths
ALPACA_OUTPUT_DIR=output/alpaca
DATA_DIR=data
SQLITE_PATH=data/trader.db
SNAPSHOTS_DIR=data/snapshots

# Optional: disable Schwab integration (useful for MOCK_LLM or without Schwab keys)
SCHWAB_DISABLED=true

# Model selection (defaults are ok)
TRIAGE_PROVIDER=grok
TRIAGE_MODEL=grok-4.1-fast-reasoning
RESEARCH_PROVIDER=openai
RESEARCH_MODEL=gpt-5-mini
SENTIMENT_PROVIDER=gemini
SENTIMENT_MODEL=gemini-3-flash-preview
XSEARCH_PROVIDER=grok
XSEARCH_MODEL=grok-4.1-fast-reasoning
SYNTHESIS_MODEL=gemini-3-flash-preview

# Budgets/limits
MAX_DAILY_COST=5.00
MAX_COST_PER_NEWS_ITEM=0.50
MAX_TOTAL_HOPS=3
MAX_WEB_SEARCHES_PER_ITEM=3
MAX_X_SEARCHES_PER_ITEM=2

# Pipeline per-agent limits (safety nets — agents run to completion)
PIPELINE_REQUEST_LIMIT=15
PIPELINE_TOOL_CALLS_LIMIT=25
# Cost-based budget: skip remaining intermediate agents when cumulative
# pipeline cost exceeds this (USD). Final agent always runs.
PIPELINE_MAX_COST_USD=0.50

# Explorer v1 (Phase 2)
MAX_PHASE1_ACTIONS=4
MAX_PHASE2_BRANCHES=2

# Web
SSE_PING_INTERVAL_S=10

# -----------------------------
# X API v2 (optional)
# -----------------------------

# Bearer token is sufficient for read-only stream/rules/usage
X_BEARER_TOKEN=<optional>
X_API_BASE_URL=https://api.x.com

# Conservative burst-only defaults (keep enabled=false until you want to test)
X_STREAM_ENABLED=false
X_STREAM_MODE=burst
X_MAX_POSTS_PER_DAY=1000
X_MAX_BURSTS_PER_DAY=10
X_BURST_TTL_MINUTES=5
X_USAGE_POLL_INTERVAL_S=300
X_MIN_TRIAGE_CONFIDENCE_FOR_BURST=0.75

# X stream quality gate
X_STREAM_QUALITY_CHECK_ENABLED=true
X_STREAM_QUALITY_CHECK_AFTER=5
X_STREAM_QUALITY_CHECK_MODEL=gemini-3-flash-preview
X_STREAM_QUALITY_MAX_RETRIES=3
X_STREAM_MARKET_HOURS_ONLY=true

# -----------------------------
# Evidence acquisition (optional)
# -----------------------------

EVIDENCE_ACQUIRE_ENABLED=false
EVIDENCE_MAX_DOCS_PER_ITEM=3
EVIDENCE_EXTRACTOR=trafilatura

# -----------------------------
# Watch lifecycle
# -----------------------------

WATCH_ENABLED=true
WATCH_CONFIDENCE_THRESHOLD=0.7
MAX_CONCURRENT_WATCHES=5
WATCH_MONITORING_BUDGET=0.50
WATCH_MAX_HOLD_MINUTES=240
WATCH_MAX_RETRO_MINUTES=60
WATCH_CHECKIN_MODEL=gemini-3-flash

# -----------------------------
# Follow-up Data Collection
# -----------------------------

FOLLOW_UP_ENABLED=true
FOLLOW_UP_SCHEDULE=+1h,+4h,+1d,+3d,+5d
FOLLOW_UP_WEB_SEARCHES=2
FOLLOW_UP_X_SEARCHES=1
FOLLOW_UP_MAX_COST=0.20
FOLLOW_UP_MAX_CONCURRENT=20
FOLLOW_UP_COLLECTOR_INTERVAL_S=300
FOLLOW_UP_PLANNER_MODEL=gemini-3-flash

# -----------------------------
# Reflection / Evaluation
# -----------------------------

REFLECTION_MODEL=gemini-3-flash-preview