# -----------------------------
# API Keys
# -----------------------------
OPENAI_API_KEY=<optional>
# GEMINI_API_KEY=<optional>
GOOGLE_API_KEY=<optional>
XAI_API_KEY=<optional>
XAI_BASE_URL=https://api.x.ai/v1
FINNHUB_API_KEY=<optional>
INSIGHT_SENTRY_API_KEY=<optional>
X_BEARER_TOKEN=<optional>
X_API_BASE_URL=https://api.x.com
SCHWAB_APP_KEY=<optional>
SCHWAB_APP_SECRET=<optional>

# -----------------------------
# Modes
# -----------------------------
DEBUG=false
ONLINE=true
ONLINE_AUTO_MARKET_HOURS=true
# SCHWAB_DISABLED=true
MOCK_LLM=false
BACKFILL_ON_START=false
BACKFILL_LIMIT=5
WS_INSIGHT_SENTRY=true
WS_ALPACA=false

# -----------------------------
# Models
# -----------------------------
TRIAGE_MODEL=gemini-3-flash-preview
RESEARCH_MODEL=gpt-5-mini
XSEARCH_MODEL=grok-4-1-fast-reasoning
SYNTHESIS_MODEL=gemini-3-flash-preview
SYNTHESIS_FALLBACK_MODEL=gemini-3.1-pro-preview
WATCH_CHECKIN_MODEL=gemini-3-flash-preview
FOLLOW_UP_PLANNER_MODEL=gemini-3-flash-preview
PATTERN_REVIEW_MODEL=gpt-5.2
REFLECTION_MODEL=gemini-3-flash-preview

# -----------------------------
# Timeouts / Reasoning
# -----------------------------
RUNNER_CALL_TIMEOUT_S=200
RUNNER_PREFLIGHT_TIMEOUT_S=15
PIPELINE_AGENT_TIMEOUT_S=200
# TRIAGE_TIMEOUT_S=90
# LLM_CALL_TIMEOUT_S=180
# OPENAI_REASONING_EFFORT=medium
# GEMINI_THINKING_LEVEL=dynamic
SSE_PING_INTERVAL_S=10

# -----------------------------
# Trading / Alpaca
# -----------------------------
ALPACA_PAPER=true
ALPACA_EXTENDED_HOURS=true
# ALPACA_STOP_MODE=fractional_day
ALPACA_FILL_TIMEOUT=30
RECONCILE_INTERVAL=600
# EQUITY_SNAPSHOT_INTERVAL=60
ALPACA_PAPER_NAME_1=AlpacaPaper1
ALPACA_PAPER_ACCOUNT_1=<optional>
ALPACA_API_KEY_1=<required-for-alpaca>
ALPACA_SECRET_KEY_1=<required-for-alpaca>
ALPACA_PAPER_NAME_2=AlpacaPaper2
ALPACA_PAPER_ACCOUNT_2=<optional>
ALPACA_API_KEY_2=<optional>
ALPACA_SECRET_KEY_2=<optional>
ALPACA_PAPER_NAME_3=AlpacaPaper3
ALPACA_PAPER_ACCOUNT_3=<optional>
ALPACA_API_KEY_3=<optional>
ALPACA_SECRET_KEY_3=<optional>


# -----------------------------
# Pipeline
# -----------------------------
MAX_DAILY_COST=10.00
MAX_COST_PER_NEWS_ITEM=0.50
MAX_TOTAL_HOPS=10
MAX_WEB_SEARCHES_PER_ITEM=10
MAX_X_SEARCHES_PER_ITEM=10

TRIAGE_SYMBOL_COOLDOWN_MINUTES=240
TRIAGE_MAX_SYMBOLS=2
TRIAGE_WEB_SEARCH=false
TRIAGE_CONCURRENCY=3

PIPELINE_REQUEST_LIMIT=15
PIPELINE_TOOL_CALLS_LIMIT=50
PIPELINE_MAX_COST_USD=0.50
PIPELINE_INCLUDE_OPENAI=false
OPENAI_WEB_SEARCH_LIMIT=10

MAX_PARALLEL_EXPLORES=5
MAX_PHASE1_ACTIONS=4
MAX_PHASE2_BRANCHES=2
PRICE_DELAY_MINUTES='5'
STATS_RESOLUTION_MINUTES=60

# -----------------------------
# Watch
# -----------------------------
WATCH_ENABLED=true
WATCH_CONFIDENCE_THRESHOLD=0.7
MAX_CONCURRENT_WATCHES=5
WATCH_MONITORING_BUDGET=0.50
WATCH_MAX_HOLD_MINUTES=240
WATCH_MAX_RETRO_MINUTES=60

# -----------------------------
# Follow-up
# -----------------------------
FOLLOW_UP_ENABLED=false
FOLLOW_UP_SCHEDULE=+1h,+4h,+1d,+3d,+5d
FOLLOW_UP_WEB_SEARCHES=2
FOLLOW_UP_X_SEARCHES=1
FOLLOW_UP_MAX_COST=0.20
FOLLOW_UP_MAX_CONCURRENT=20
FOLLOW_UP_COLLECTOR_INTERVAL_S=300

# -----------------------------
# Pattern Review
# -----------------------------
PATTERN_REVIEW_ENABLED=false
PATTERN_REVIEW_INTERVAL_S=10800
PATTERN_REVIEW_LOOKBACK_HOURS=6

# -----------------------------
# X Stream
# -----------------------------
X_STREAM_ENABLED=false
X_STREAM_MODE=burst
X_MAX_POSTS_PER_DAY=1000
X_MAX_BURSTS_PER_DAY=10
X_BURST_TTL_MINUTES=5
X_USAGE_POLL_INTERVAL_S=300
X_MIN_TRIAGE_CONFIDENCE_FOR_BURST=0.75
X_STREAM_QUALITY_CHECK_ENABLED=true
X_STREAM_QUALITY_CHECK_AFTER=5
X_STREAM_QUALITY_CHECK_MODEL=gemini-3-flash-preview
X_STREAM_QUALITY_MAX_RETRIES=3
X_STREAM_MARKET_HOURS_ONLY=true

# -----------------------------
# Evidence
# -----------------------------
EVIDENCE_ACQUIRE_ENABLED=true
EVIDENCE_EXTRACTOR=trafilatura
EVIDENCE_MAX_DOCS_PER_ITEM=3

# -----------------------------
# Notifications
# -----------------------------
NOTIFY_EMAIL_TO=<optional>
NOTIFY_SMTP_PASSWORD=<optional>
# NOTIFY_EMAIL_FROM=
# NOTIFY_SMTP_HOST=smtp.gmail.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=

# -----------------------------
# Tick Collector
# -----------------------------
TICK_PORTFOLIO_SYNC_INTERVAL=30
TICK_PORTFOLIO_COOLOFF_MIN=300
# TICK_FLUSH_INTERVAL=2.0
# TIMESCALE_DSN=postgres://postgres:postgres@localhost:5432/ticks
# TRADER_DB_PATH=data/trader.db

# -----------------------------
# Paths
# -----------------------------
DATA_DIR=data
ALPACA_NEWS_DIR=data/news/incoming/alpaca
INSIGHT_SENTRY_NEWS_DIR=data/news/incoming/insight_sentry
NEWS_WATCH_DIRS=data/news/incoming/alpaca,data/news/incoming/insight_sentry
NEWS_ARCHIVE_DIR=data/news/archive
NEWS_ARCHIVE_HOT_HOURS=24
NEWS_ARCHIVE_RETENTION_DAYS=90
NEWS_ARCHIVE_INTERVAL_S=3600

SNAPSHOTS_DIR=data/snapshots
SNAPSHOT_ARCHIVE_DIR=data/snapshots/archive
SNAPSHOT_ARCHIVE_HOT_HOURS=24
SNAPSHOT_ARCHIVE_RETENTION_DAYS=90

SQLITE_PATH=data/trader.db
LOG_FILE=logs/trader.log
LOG_LEVEL=WARNING
LOG_KEEP_DAYS=14
